+static void free_urb_and_buffer(struct snd_usb_midi *umidi, struct urb *urb,
+				unsigned int buffer_length)
+{
+	usb_buffer_free(umidi->dev, buffer_length,
+			urb->transfer_buffer, urb->transfer_dma);
